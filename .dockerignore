# Version-control
.git
.gitignore
.gitattributes

# Docs & config at repo root (not needed in container).
# Legal material is an explicit exception: LICENSE and THIRD_PARTY_NOTICES.md
# must stay in the build context so the runtime image can ship them (MIT
# requires the notice to accompany every copy of the software).
README.md
CONTRIBUTING.md
.env
.env.*
*.md
!THIRD_PARTY_NOTICES.md
docs/

# Test & CI tooling
**/tests/
**/__pycache__/
**/*.pyc
**/*.pyo
**/.pytest_cache/
**/htmlcov/
**/.mypy_cache/
**/.ruff_cache/
**/node_modules/
**/.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS noise
.DS_Store
Thumbs.db

# Build artifacts
dist/
build/
*.egg-info/
*.whl

# FastAPI / uvicorn run artifacts
*.log
pid
